<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <servers>
    <server>
      <id>jfrog-maven-virtual</id>
      <username>${env.JFROG_USERNAME}</username>
      <password>${env.JFROG_TOKEN}</password>
    </server>
    <server>
      <id>jfrog-release-candidates</id>
      <username>${env.JFROG_USERNAME}</username>
      <password>${env.JFROG_TOKEN}</password>
    </server>
    <server>
      <id>jfrog-snapshots</id>
      <username>${env.JFROG_USERNAME}</username>
      <password>${env.JFROG_TOKEN}</password>
    </server>
    <server>
      <id>jfrog-production-releases</id>
      <username>${env.JFROG_USERNAME}</username>
      <password>${env.JFROG_TOKEN}</password>
    </server>
  </servers>
  <mirrors>
    <mirror>
      <id>jfrog-maven-virtual</id>
      <name>Route all Maven dependency and plugin resolution through JFrog</name>
      <url>${env.JFROG_URL}/artifactory/${env.JFROG_MAVEN_VIRTUAL_REPO}</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>
</settings>
