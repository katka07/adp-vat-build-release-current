digraph release_flow {
  rankdir=TB;
  graph [fontname="Arial", bgcolor="white", pad="0.3", nodesep="0.35", ranksep="0.45"];
  node [shape=box, style="rounded", fontname="Arial", fontsize=10];
  edge [fontname="Arial", fontsize=9];

  git [label="Git commit / release tag"];
  jenkins [label="Jenkins release pipeline"];
  maven [label="Maven clean deploy\ncompile + unit + JAR smoke + integration"];
  candidate [label="JFrog candidate repository\nimmutable versioned JAR"];
  sonar [label="SonarQube quality gate"];
  qa_deploy [label="Ansible deploy to QA"];
  qa_sqa [label="Unified QA / SQA stage\nMaven qualification + regression + approval\nexact Artifactory candidate"];
  promote [label="JFrog promotion\ncopy same bytes to production repo"];
  prod_deploy [label="Ansible serial production deploy"];
  verify [label="Production-safe verification"];
  done [label="Release complete"];
  rollback [label="Rollback\nprevious/approved production JAR"];

  git -> jenkins -> maven -> candidate -> sonar -> qa_deploy -> qa_sqa -> promote -> prod_deploy -> verify -> done;
  verify -> rollback [label="failure"];
  rollback -> done [label="restored"];
}
